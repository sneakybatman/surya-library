{
  "name": "library-surya",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute library-db --remote --file=schema.sql",
    "db:seed": "wrangler d1 execute library-db --remote --file=seed/seed.sql",
    "db:schema:local": "wrangler d1 execute library-db --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute library-db --local --file=seed/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
